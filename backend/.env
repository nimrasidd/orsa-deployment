# Backend environment (used by Docker Compose via env_file)
#
# PostgreSQL MUST be installed on the SERVER (outside Docker).
# Use the SERVER IP/hostname here (NOT "db" and NOT "localhost" inside Docker).
#
##DATABASE_URL=postgresql://postgres:abc123@host.docker.internal:5432/postgres

# Local dev (no Docker): SQLite
# Local dev: Docker Postgres is published on localhost:5432; data lives in database "orsa_db".
DATABASE_URL=postgresql://postgres:abc123@127.0.0.1:5432/Orsa_Solvency

# Allow your UI origin(s) (comma-separated) or "*" for dev
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5176,http://localhost:5176

# JWT signing key (change in production; keep stable across restarts)
SECRET_KEY=RxdV4mciBb5pYLlSqLfFGcXFesiia2xzyQCNtVXUb2u4GZTx2Llgks7v6w63WsgaB3tDsI88hAZJfhwK5VzE2A==12123@127