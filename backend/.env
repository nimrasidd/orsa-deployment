# Option 1: SQLite (local, no Supabase needed) - data stored in backend/osra.db
# DATABASE_URL=sqlite:///./osra.db

# Option 2: Supabase direct (port 5432) - requires IPv6
# DATABASE_URL=postgresql://postgres:x2OTPf0UydyZpecT@db.tzniuitcpcyfvavyzpwk.supabase.co:5432/postgres

# Option 3: Supabase Transaction pooler (port 6543) - supports IPv4, more reliable
# DATABASE_URL=postgresql://postgres:x2OTPf0UydyZpecT@db.tzniuitcpcyfvavyzpwk.supabase.co:6543/postgres

# Option 4: Local PostgreSQL
# Replace POSTGRES_USER with your username if different (default: postgres)
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/ORSA%20DB

# Using SQLite for local dev (no Postgres needed, login works out of the box)
DATABASE_URL=sqlite:///./osra.db

# CORS_ORIGINS can be "*" or comma-separated origins (e.g. http://localhost:5173)

SUPABASE_URL=https://tzniuitcpcyfvavyzpwk.supabase.co
