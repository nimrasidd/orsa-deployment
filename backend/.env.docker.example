## Copy to backend/.env.docker on the Linux server (not committed to git).
## cp backend/.env.docker.example backend/.env.docker
##
## Optional: create .env in repo root for docker-compose.prod.yml only:
##   POSTGRES_PASSWORD=...
##   FRONTEND_PORT=5173
##   BACKEND_PORT=8000

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db:5432/orsa_db

# Your server URL(s), comma-separated (use the host port users open in the browser)
CORS_ORIGINS=http://YOUR_SERVER_IP:5173

# Generate a long random string and keep it stable across restarts
SECRET_KEY=change-me-to-a-long-random-string
