## Copy to backend/.env.docker on the Linux server (not committed to git).
## cp backend/.env.docker.example backend/.env.docker
##
## Prod compose uses fixed ports: frontend 5174, backend 8001, Postgres password abc123.

DATABASE_URL=postgresql://postgres:abc123@db:5432/orsa_db

# Must match the URL users open (5173 dev UI and/or 5174 prod UI on same server)
CORS_ORIGINS=http://YOUR_SERVER_IP:5173,http://YOUR_SERVER_IP:5174

# Generate a long random string and keep it stable across restarts
SECRET_KEY=change-me-to-a-long-random-string
